# QUEST — local development environment template.
# Copy to .env and adjust. Never commit .env. All values below are local-only defaults, not secrets.

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins (web + admin dev servers). Empty = same-origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Global rate limit architecture: requests per window per client (Phase 00 uses in-memory storage).
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ---- PostgreSQL (PostGIS + pgvector enabled by migrations) ----
DATABASE_URL=postgresql://quest:quest@localhost:5432/quest
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- Redis (cache / hot counters / rate limits — never a system of record) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, AWS S3 in cloud). Domain code uses the ObjectStoragePort only. ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quest-media-local
S3_ACCESS_KEY_ID=quest-local
S3_SECRET_ACCESS_KEY=quest-local-secret
S3_FORCE_PATH_STYLE=true

# ---- AI Gateway (Phase 00 defines interfaces only; no provider is called) ----
AI_PROVIDER=none
AI_MODEL_DEFAULT=
AI_REQUEST_TIMEOUT_MS=20000

# ---- Observability ----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=quest-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Identity (Phase 01, ADR-011). Access tokens are HS256 JWTs; refresh tokens are opaque and rotated. ----
# Generate a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=local-development-only-secret-change-me-0123456789
AUTH_JWT_SECRET_PREVIOUS=
AUTH_JWT_ISSUER=quest-api
AUTH_JWT_AUDIENCE=quest-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_SESSION_ABSOLUTE_TTL_DAYS=90
AUTH_MAX_SESSIONS_PER_ACCOUNT=20
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_VERIFICATION_CODE_TTL_MINUTES=15
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_TERMS_VERSION=2026-09
AUTH_PRIVACY_POLICY_VERSION=2026-09
# Local-only identity provider adapter (idToken = "fake:<subject>:<email>"). Refused in production.
AUTH_FAKE_PROVIDER_ENABLED=true
# Real providers are enabled by setting their client ids (audience of the id_token).
AUTH_APPLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_ID=
# Mail: `log` prints delivery lines (no mail is sent yet); set AUTH_DEV_EXPOSE_CODES=true to see codes locally.
MAIL_PROVIDER=log
AUTH_DEV_EXPOSE_CODES=true
# Optional public CDN base for avatars; unset = pre-signed download URLs.
MEDIA_PUBLIC_BASE_URL=

# ---- Web / Admin (Next.js public variables are exposed to the browser) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Mobile (Expo public variables are bundled into the app) ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
